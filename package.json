{
  "name": "mimir",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Hypermodern, runic-forged browser HUD and desktop explorer",
  "scripts": {
    "dev": "vite",
    "build:ui": "tsc -b && vite build",
    "build:rust": "cargo build --manifest-path src-rust/Cargo.toml",
    "build:installer": "cargo build --release --manifest-path src-rust/Cargo.toml --bin mimir-installer",
    "build": "npm run build:ui && npm run build:rust",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.7.3",
    "vite": "^6.2.0"
  }
}
